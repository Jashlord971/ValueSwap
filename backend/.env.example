# Copy this to .env and fill in your values

# Firebase project ID (visible in Firebase console)
FIREBASE_PROJECT_ID=your-project-id

# Google Cloud Vision API key (enable the Vision API in GCP console)
# Used for OCR scanning of gift card images
GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key

# Log level: error | warn | info | debug | trace
RUST_LOG=info

# Port to listen on (default 8080)
PORT=8080
